# Copier avec scripts/Initialize-Local.ps1. Aucun mot de passe administrateur ici.
DATABASE_URL=postgresql://centre:CHANGE_ME@127.0.0.1:5434/centre_formation?schema=public
POSTGRES_USER=centre
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=centre_formation
POSTGRES_PORT=5434
# Origine canonique sans chemin. HTTPS obligatoire en production hors localhost.
NEXTAUTH_URL=http://localhost:3000
# Générer un secret aléatoire ; cette valeur d’exemple est refusée par l’application.
NEXTAUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
ADMIN_IDENTIFIER=administrateur
# Également utilisé par Docker ; les calculs métier utilisent explicitement Africa/Tunis.
TZ=Africa/Tunis
NEXT_TELEMETRY_DISABLED=1

# Example only. Generate .env.production with scripts/docker/create-production-env.sh.
# Never commit the real file or pass these secrets as Docker build arguments.
APP_IMAGE_TAG=production
POSTGRES_USER=successway
POSTGRES_DB=successway
POSTGRES_PASSWORD=CHANGE_ME
# The password here must match POSTGRES_PASSWORD; use URL-safe generated hex.
DATABASE_URL=postgresql://successway:CHANGE_ME@db:5432/successway?schema=public
NEXTAUTH_URL=https://gestion.successway.tn
NEXTAUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
ADMIN_IDENTIFIER=administrateur
# NODE_ENV=production, HOSTNAME=0.0.0.0, PORT=3000 and TZ=Africa/Tunis
# are fixed in Compose. The administrator password is supplied interactively,
# never stored in this file.
